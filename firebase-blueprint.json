{
  "entities": {
    "ValidationDoc": {
      "title": "ValidationDoc",
      "description": "Validation et décisions de créneaux (Cycle 1 / Cycle 2) pour une date donnée.",
      "type": "object",
      "properties": {
        "ts": { "type": "number", "description": "Timestamp de validation." },
        "k": { "type": "string", "maxLength": 120, "description": "Signature ou code global du jour." },
        "author": { "type": "string", "maxLength": 80, "description": "Nom de la personne ayant validé (ex: Jérôme, Benoît)." },
        "items": { "type": "array", "description": "Liste des décisions par créneau." },
        "updatedAt": { "type": "number", "description": "Timestamp de dernière mise à jour." }
      },
      "required": ["items"]
    },
    "CustomSlotDoc": {
      "title": "CustomSlotDoc",
      "description": "Configuration de créneaux sur mesure pour une journée spécifique.",
      "type": "object",
      "properties": {
        "replaceDefault": { "type": "boolean", "description": "Si vrai, remplace les créneaux automatiques calculés." },
        "slots": { "type": "array", "description": "Liste des créneaux sur-mesure." },
        "updatedBy": { "type": "string", "maxLength": 80, "description": "Dernier moniteur ayant modifié." },
        "updatedAt": { "type": "number", "description": "Timestamp de modification." }
      },
      "required": ["replaceDefault", "slots"]
    },
    "SlotObservation": {
      "title": "SlotObservation",
      "description": "Relevé terrain (REX), écart de marée/surcote ou motif d'annulation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant unique du relevé." },
        "ds": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date YYYY-MM-DD." },
        "slotKey": { "type": "string", "maxLength": 64, "description": "Clé du créneau horaire." },
        "slotStart": { "type": "string", "maxLength": 16, "description": "Heure de début." },
        "slotEnd": { "type": "string", "maxLength": 16, "description": "Heure de fin." },
        "status": { "type": "string", "enum": ["realized", "cancelled"] },
        "cancellationReason": { "type": "string", "maxLength": 120 },
        "cancellationNote": { "type": "string", "maxLength": 1000 },
        "timeDeltaMin": { "type": "number" },
        "waterDeltaCm": { "type": "number" },
        "observedWaterH": { "type": "number" },
        "observedPressure": { "type": "number" },
        "observedWindKts": { "type": "number" },
        "observedGustKts": { "type": "number" },
        "observedWindDir": { "type": "string", "maxLength": 32 },
        "observedWaveH": { "type": "number" },
        "beachCondition": { "type": "string", "maxLength": 80 },
        "participantsCount": { "type": "number" },
        "monoCount": { "type": "number" },
        "biCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "maxLength": 80, "description": "Moniteur ayant saisi le relevé." },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ds", "slotKey", "slotStart", "slotEnd", "status"]
    },
    "ReservationDoc": {
      "title": "ReservationDoc",
      "description": "Feuille d'émargement et réservations clients pour une date et un créneau.",
      "type": "object",
      "properties": {
        "ds": { "type": "string", "maxLength": 16, "description": "Date YYYY-MM-DD." },
        "slotKey": { "type": "string", "maxLength": 64, "description": "Clé du créneau." },
        "clients": { "type": "array", "description": "Liste des clients inscrits." },
        "updatedBy": { "type": "string", "maxLength": 80, "description": "Moniteur ayant inscrit ou modifié." },
        "updatedAt": { "type": "number", "description": "Timestamp de mise à jour." }
      },
      "required": ["ds", "slotKey", "clients"]
    },
    "AppConfigDoc": {
      "title": "AppConfigDoc",
      "description": "Configuration globale de l'école (session_settings, beach_cadre_roulage).",
      "type": "object",
      "properties": {
        "updatedBy": { "type": "string", "enum": ["Jérôme", "Benoît", "Admin", "Jerome", "Benoit"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["updatedBy"]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "Fiche client centralisée (CRM) avec coordonnées, historique de séances et préférences.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 120 },
        "lastName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 160 },
        "city": { "type": "string", "maxLength": 120 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "level": { "type": "string", "maxLength": 60 },
        "preferredGear": { "type": "string", "maxLength": 60 },
        "totalSessions": { "type": "number" },
        "lastSessionDate": { "type": "string", "maxLength": 32 },
        "totalSpent": { "type": "number" },
        "hasGiftVoucher": { "type": "boolean" },
        "giftVoucherBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 3000 },
        "tags": { "type": "array" },
        "author": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lastName"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Profil utilisateur avec rôle, mot de passe haché SHA-256 et permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 60 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "moniteur"] },
        "passwordHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "minLength": 64, "maxLength": 64 },
        "isReadOnly": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["username", "role", "passwordHash"]
    },
    "TeamNoteDoc": {
      "title": "TeamNoteDoc",
      "description": "Notes d'échange Ben ↔ Jérôme ainsi que les documents techniques d'état (status_tech_notes, qcm_tech_notes, audit_data_c1_c2).",
      "type": "object",
      "properties": {
        "author": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 60 },
        "content": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "isResolved": { "type": "boolean" },
        "resolvedAt": { "type": "number" },
        "resolvedBy": { "type": "string", "maxLength": 80 }
      }
    },
    "WaterlineGpsLog": {
      "title": "WaterlineGpsLog",
      "description": "Relevé GPS de la limite basse (front de l'eau) avec largeur calculée depuis la dune et position latérale.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "number" },
        "dateStr": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "timeStr": { "type": "string", "maxLength": 16 },
        "author": { "type": "string", "maxLength": 80 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracyM": { "type": "number" },
        "measuredWidthFromDuneM": { "type": "number" },
        "lateralPosFromLeftM": { "type": "number" },
        "lateralPosPct": { "type": "number" },
        "isInsideZone": { "type": "boolean" },
        "cadreProfileUsed": { "type": "string", "enum": ["jerome", "mairie"] },
        "realWeatherSnapshot": { "type": "object" },
        "consolidationStatus": { "type": "string", "enum": ["pending_offline", "pending_real", "consolidated"] },
        "offlineQueued": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 1000 }
      },
      "required": ["timestamp", "dateStr", "author", "latitude", "longitude"]
    }
  },
  "firestore": {
    "/validations/{dateStr}": {
      "schema": "ValidationDoc",
      "description": "Décisions prises sur les créneaux pour une date donnée."
    },
    "/custom_slots/{dateStr}": {
      "schema": "CustomSlotDoc",
      "description": "Créneaux spécifiques créés pour une date donnée."
    },
    "/observations/{obsId}": {
      "schema": "SlotObservation",
      "description": "Relevés terrain (REX) et observations pour les statistiques et la calibration."
    },
    "/reservations/{reservationKey}": {
      "schema": "ReservationDoc",
      "description": "Inscriptions clients et émargement de séance."
    },
    "/clients/{clientId}": {
      "schema": "ClientProfile",
      "description": "Fiches clients centralisées de l'école (CRM)."
    },
    "/app_config/{configId}": {
      "schema": "AppConfigDoc",
      "description": "Paramètres globaux de l'école (session_settings, beach_cadre_roulage) réservés aux administrateurs."
    },
    "/app_users/{userId}": {
      "schema": "AppUser",
      "description": "Comptes utilisateurs avec rôle et empreinte SHA-256."
    },
    "/team_notes/{noteId}": {
      "schema": "TeamNoteDoc",
      "description": "Espace d'échange Ben ↔ Jérôme et documents de suivi technique (QCM, statuts, visas d'audit)."
    },
    "/waterline_gps_logs/{logId}": {
      "schema": "WaterlineGpsLog",
      "description": "Relevés GPS terrain de la limite basse de roulage (front d'eau)."
    }
  }
}
