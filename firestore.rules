rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Décisions et validations de créneaux par date
    match /validations/{dateStr} {
      allow read, write: if true;
    }

    // Créneaux sur mesure par date
    match /custom_slots/{dateStr} {
      allow read, write: if true;
    }

    // Relevés terrain et calibration du spot
    match /observations/{obsId} {
      allow read, write: if true;
    }

    // Émargement et inscriptions clients par créneau
    match /reservations/{reservationKey} {
      allow read, write: if true;
    }

    // Répertoire centralisé et base de données clients (CRM)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Configuration et sécurité école et moniteurs
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // Test de connectivité
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
