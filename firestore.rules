rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Décisions et validations de créneaux par date
    match /validations/{dateStr} {
      allow read, write: if true;
    }

    // Créneaux sur mesure par date
    match /custom_slots/{dateStr} {
      allow read, write: if true;
    }

    // Relevés terrain et calibration du spot
    match /observations/{obsId} {
      allow read, write: if true;
    }

    // Émargement et inscriptions clients par créneau
    match /reservations/{reservationKey} {
      allow read, write: if true;
    }

    // Répertoire centralisé et base de données clients (CRM)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Configuration et sécurité école et moniteurs (Module 3 : Verrouillage admin)
    match /app_config/{configId} {
      allow read: if true;
      // Seuls les administrateurs habilités (Jérôme, Benoît) peuvent modifier ou réinitialiser la configuration de l'école
      allow write: if request.resource.data.updatedBy in ['Jérôme', 'Benoît', 'Admin', 'Jerome', 'Benoit'];
    }

    // Profils et comptes moniteurs/administrateurs
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // Espace d'échange et carnet de liaison Ben ↔ Jérôme (Module 7)
    match /team_notes/{noteId} {
      allow read, write: if true;
    }

    // Relevés GPS de limite basse de roulage (Étalonnage terrain en direct)
    match /waterline_gps_logs/{logId} {
      allow read, write: if true;
    }

    // Test de connectivité
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
